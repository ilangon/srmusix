<Window x:Class="FFmpegNativePlayer.ChromaKeyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SMART PLAYOUT • CHROMA KEY STUDIO" Width="1680" Height="940" MinWidth="1280" MinHeight="760" WindowStartupLocation="CenterOwner" Background="#09131D" Foreground="#EAF2F8">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101F2D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#36566E"/><Setter Property="CaretBrush" Value="#58D7FF"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#101F2D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#36566E"/><Setter Property="Padding" Value="5"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#101F2D"/><Setter Property="Foreground" Value="#F4F8FC"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24516D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D6E94"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#17344A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#496E88"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0E1A25"/><Setter Property="BorderBrush" Value="#29465C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="9"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B7C8D6"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="58"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border Background="#0C1B29" BorderBrush="#29465C" BorderThickness="0,0,0,1"><Grid Margin="14,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SMART PLAYOUT • CHROMA KEY STUDIO" Foreground="#59D5FF" FontSize="23" FontWeight="Bold"/><TextBlock Text="INPUT • KEY • COMPOSITE • PROGRAM" Foreground="#7894A8" FontSize="10"/></StackPanel><Border Grid.Column="1" Background="#123C2C" BorderBrush="#21D779" BorderThickness="1" CornerRadius="5" Padding="18,7" Margin="8,0"><TextBlock Text="●  PROGRAM ON AIR" Foreground="#71F6A8" FontWeight="Bold"/></Border><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="1080p50&#x0a;HD 1920 × 1080" FontWeight="Bold" Margin="10"/><TextBlock x:Name="AudioMeterText" Text="AUDIO L  ▯▯▯▯▯▯▯▯&#x0a;AUDIO R  ▯▯▯▯▯▯▯▯" Foreground="#59E38D"/></StackPanel><StackPanel Grid.Column="3" Margin="22,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Text="00:00:00" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="DateText" Text="—" Foreground="#8FA8BA" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="INPUT PREVIEW" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="1920 × 1080p50" Foreground="#8FA8BA"/></DockPanel><Border Grid.Row="1" Background="Black"><Image x:Name="InputPreview" Stretch="Uniform" PreviewMouseLeftButtonDown="InputPreview_MouseLeftButtonDown"/></Border></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="MATTE VIEW" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="White = keep   Black = transparent" Foreground="#8FA8BA"/></DockPanel><Border Grid.Row="1" Background="Black"><Image x:Name="MattePreview" Stretch="Uniform"/></Border></Grid></Border>
   </Grid>
   <Grid Grid.Column="1" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="KEYED PREVIEW" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="Composite View" Foreground="#8FA8BA"/></DockPanel><Grid x:Name="KeyedPreviewSurface" Grid.Row="1" Background="Black" ClipToBounds="True" SizeChanged="KeyedPreviewSurface_SizeChanged"><Image x:Name="BackgroundPreview" Stretch="UniformToFill"/><Image x:Name="ForegroundPreview" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="PROGRAM OUTPUT" FontWeight="Bold"/><Border DockPanel.Dock="Right" Background="#123C2C" Padding="8,2"><TextBlock Text="● ON AIR" Foreground="#71F6A8"/></Border></DockPanel><Border Grid.Row="1" Background="Black"><Image x:Name="ProgramPreview" Stretch="Uniform"/></Border></Grid></Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="CHROMA KEY PROPERTIES" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
    <TextBlock Text="SOURCE" Foreground="#58D7FF" FontWeight="Bold"/><TextBlock Text="Video Input Source" Style="{StaticResource Label}"/><ComboBox x:Name="VideoSourceCombo" Margin="0,3,0,4"/><TextBlock Text="Network / Stream URL" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="TEST URL" Click="TestUrl_Click" ToolTip="Validate and resolve the URL before preview"/><TextBox x:Name="SourceAddress" Margin="0,3,0,6" ToolTip="HTTP/HLS, RTSP, RTMP, SRT, UDP or RTP URL"/></DockPanel><TextBlock Text="Enter URL → TEST URL → Refresh Source for Preview → TAKE TO AIR." Foreground="#7894A8" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Audio Input Source" Style="{StaticResource Label}"/><ComboBox x:Name="AudioSourceCombo" Margin="0,3,0,6"><ComboBoxItem Content="AUTO – Follow Video Source" IsSelected="True"/><ComboBoxItem Content="MANUAL – Select Audio Device"/><ComboBoxItem Content="Audio Off / Video Only"/></ComboBox><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/><TextBox x:Name="BackgroundPath" IsReadOnly="True" ToolTip="Background image or video"/></DockPanel><TextBlock Text="Select video and AUTO embedded audio, or choose an external mixer/input." Foreground="#7894A8" FontSize="10" TextWrapping="Wrap"/>
    <Separator Margin="0,9"/><TextBlock Text="KEY COLOR" Foreground="#58D7FF" FontWeight="Bold"/><DockPanel Margin="0,3,0,4"><Border x:Name="KeyColorSwatch" Width="40" Height="32" CornerRadius="4" BorderBrush="#A8C5D9" BorderThickness="1" Margin="0,0,7,0"/><StackPanel><TextBlock Text="PICK EXACT BACKGROUND COLOUR" FontWeight="Bold" FontSize="10"/><TextBlock Text="Use the colour-picker, then click the green/blue area in Input Preview." Foreground="#7894A8" FontSize="10" TextWrapping="Wrap"/></StackPanel></DockPanel><WrapPanel><Button Content="⌖  PICK COLOUR FROM VIDEO" Click="Eyedropper_Click" ToolTip="Colour picker — click an exact colour in the Input Preview"/><Button Content="● Green Preset" Foreground="#65F08E" Click="GreenPreset_Click"/><Button Content="● Blue Preset" Foreground="#6EA8FF" Click="BluePreset_Click"/></WrapPanel><TextBlock Text="Hex Value" Style="{StaticResource Label}"/><TextBox x:Name="KeyHex" Text="#00FF00" TextChanged="PreviewChanged"/>
    <Separator Margin="0,9"/><TextBlock Text="KEY QUALITY • DRAG OR MOUSE-WHEEL FOR FINE CONTROL" Foreground="#58D7FF" FontWeight="Bold"/>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Similarity / Tolerance" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="Tolerance" Text="0.42" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="ToleranceSlider" Minimum="0.01" Maximum="1" Value="0.42" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Dullness" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="Dullness" Text="0.00" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="DullnessSlider" Minimum="0" Maximum="1" Value="0" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Smoothness" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="Softness" Text="0.18" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SoftnessSlider" Minimum="0" Maximum="0.5" Value="0.18" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Spill Suppression" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="SpillSuppression" Text="0.65" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SpillSlider" Minimum="0" Maximum="1" Value="0.65" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Spectral Balance" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="SpectralBalance" Text="0.50" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SpectralSlider" Minimum="0" Maximum="1" Value="0.50" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Edge Softness" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="EdgeSoftness" Text="0.18" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EdgeSoftnessSlider" Minimum="0" Maximum="1" Value="0.18" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Shadow Recovery" Style="{StaticResource Label}"/><TextBox Grid.Column="1" x:Name="ShadowRecovery" Text="0.20" TextChanged="PreviewChanged"/><Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="ShadowSlider" Minimum="0" Maximum="1" Value="0.20" SmallChange="0.01" LargeChange="0.05" ValueChanged="KeySlider_ValueChanged"/></Grid>
    <TextBlock Text="Edge Erode / Dilate (manual fine entry)" Style="{StaticResource Label}"/><TextBox x:Name="EdgeErode" Text="0.00" TextChanged="PreviewChanged"/>
    <Separator Margin="0,9"/><TextBlock Text="TRANSFORM" Foreground="#58D7FF" FontWeight="Bold"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Position X (%)" Style="{StaticResource Label}"/><TextBox x:Name="TransformX" Text="0" TextChanged="PreviewTransformChanged"/></StackPanel><StackPanel><TextBlock Text="Position Y (%)" Style="{StaticResource Label}"/><TextBox x:Name="TransformY" Text="0" TextChanged="PreviewTransformChanged"/></StackPanel><StackPanel><TextBlock Text="Width (%)" Style="{StaticResource Label}"/><TextBox x:Name="TransformW" Text="100" TextChanged="PreviewTransformChanged"/></StackPanel><StackPanel><TextBlock Text="Height (%)" Style="{StaticResource Label}"/><TextBox x:Name="TransformH" Text="100" TextChanged="PreviewTransformChanged"/></StackPanel></UniformGrid><ComboBox x:Name="ScaleMode" SelectedIndex="0" Margin="0,6" SelectionChanged="PreviewTransformSelectionChanged"><ComboBoxItem Content="Uniform Fit"/><ComboBoxItem Content="Stretch Fill"/><ComboBoxItem Content="Crop to Fill"/></ComboBox><TextBlock Text="Rotation (degrees)" Style="{StaticResource Label}"/><TextBox x:Name="Rotation" Text="0" TextChanged="PreviewTransformChanged"/><CheckBox x:Name="LockAspect" Content="Lock Aspect Ratio" IsChecked="True" Foreground="White" Margin="0,5" Checked="PreviewTransformToggleChanged" Unchecked="PreviewTransformToggleChanged"/>
    <TextBlock Text="CROP" Foreground="#58D7FF" FontWeight="Bold" Margin="0,7,0,0"/><UniformGrid Columns="4"><StackPanel><TextBlock Text="Left" Style="{StaticResource Label}"/><TextBox x:Name="CropLeft" Text="0"/></StackPanel><StackPanel><TextBlock Text="Right" Style="{StaticResource Label}"/><TextBox x:Name="CropRight" Text="0"/></StackPanel><StackPanel><TextBlock Text="Top" Style="{StaticResource Label}"/><TextBox x:Name="CropTop" Text="0"/></StackPanel><StackPanel><TextBlock Text="Bottom" Style="{StaticResource Label}"/><TextBox x:Name="CropBottom" Text="0"/></StackPanel></UniformGrid>
    <TextBlock Text="PREVIEW MODE" Foreground="#58D7FF" FontWeight="Bold" Margin="0,9,0,0"/><UniformGrid Columns="4"><Button Content="Composite" Tag="Composite" Click="PreviewMode_Click"/><Button Content="Matte" Tag="Matte" Click="PreviewMode_Click"/><Button Content="Spill" Tag="Spill" Click="PreviewMode_Click"/><Button Content="Difference" Tag="Difference" Click="PreviewMode_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="Split" Tag="Split" Click="PreviewMode_Click"/><Button Content="Planar" Tag="Planar" Click="PreviewMode_Click"/><Button Content="Track to Here" Click="Track_Click"/></UniformGrid>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Background="#0C1B29" BorderBrush="#29465C" BorderThickness="1,1,1,0"><DockPanel Margin="8"><StackPanel Orientation="Horizontal"><Button Content="↻ Refresh Source" Click="Refresh_Click"/><Button Content="▶ Preview Key" Click="Refresh_Click"/><Button Content="Reset" Click="Reset_Click"/><Button Content="Save Preset" Click="SavePreset_Click"/><Button Content="Load Preset" Click="LoadPreset_Click"/><Button Content="Key Off / Clear Background" Click="Off_Click"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="TAKE TO AIR" Background="#D92131" FontWeight="Bold" Width="150" Click="Apply_Click"/><Button Content="REMOVE FROM AIR" Width="150" Click="Off_Click"/></StackPanel></DockPanel></Border>
  <DockPanel Grid.Row="3" Margin="10,2"><TextBlock x:Name="PreviewStatus" Text="SYSTEM READY" Foreground="#70E9A0"/><TextBlock x:Name="SystemStatusText" DockPanel.Dock="Right" Text="Output: Program • Audio: AUTO • 48 kHz • CPU: 0%" Foreground="#7894A8"/></DockPanel>
  <CheckBox x:Name="EnableCheck" IsChecked="True" Visibility="Collapsed"/>
 </Grid>
</Window>
