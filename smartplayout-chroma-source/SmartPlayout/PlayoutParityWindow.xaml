<Window x:Class="FFmpegNativePlayer.PlayoutParityWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SMART PLAYOUT • PLAYOUT+ • LIVE INPUT" Width="940" Height="760" WindowStartupLocation="CenterOwner" Background="#0B1118" Foreground="#E8EDF5">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111F2B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#45647D"/><Setter Property="CaretBrush" Value="#63E7E5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#111F2B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#45647D"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#0E1822"/><Setter Property="Foreground" Value="#FFFFFF"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#24506A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#16747D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#183247"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#4B718B"/></Style>
 </Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="PLAYOUT+ • LIVE INPUT / CAPTURE" FontSize="22" FontWeight="Bold" Foreground="#8EDCFF"/><TextBlock Text="DirectShow / DeckLink capture → FINAL PROGRAM → Graphics / RTMP / DVB UDP / DVB SRT" Foreground="#9FB0C0" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Margin="0,12,0,10" Background="#111B25" BorderBrush="#2D4358" BorderThickness="1" CornerRadius="7" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LIVE INPUT DEVICE" FontWeight="Bold" Foreground="#69F0C5"/><TextBlock x:Name="LiveProbeStatus" Text="Not scanned" Foreground="#9FB0C0" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Width="150" Height="34" Content="REFRESH DEVICES" Click="RefreshDevices_Click"/></Grid></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="#111B25" CornerRadius="7" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="VIDEO DEVICE" Foreground="#63E7E5"/><ComboBox x:Name="VideoDevices" Height="32" Margin="0,4,0,10"/><TextBlock Text="AUDIO DEVICE" Foreground="#FFD36A"/><ComboBox x:Name="AudioDevices" Height="32" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button Width="130" Height="36" Content="▶ TAKE TO AIR" Click="TakeLive_Click" Foreground="#69F0C5"/><Button Width="100" Height="36" Margin="8,0,0,0" Content="■ STOP" Click="StopLive_Click" Foreground="#FF9E9E"/><Button Width="180" Height="36" Margin="8,0,0,0" Content="↩ RETURN SCHEDULE" Click="ReturnSchedule_Click" Foreground="#FFD36A"/></StackPanel><TextBlock x:Name="LiveOnAirStatus" Text="READY" Margin="0,10,0,0" Foreground="#9FB0C0" TextWrapping="Wrap"/></StackPanel></Border>
   <Border Background="#111B25" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="LIVE PIPELINE" FontWeight="Bold" Foreground="#69F0C5"/><TextBlock Text="• DirectShow video + audio capture\n• DeckLink video input when a DeckLink-capable FFmpeg runtime is available\n• Video converted to stable BGRA Program frames\n• Audio converted to 48 kHz stereo PCM with async timestamp correction\n• Existing FINAL PROGRAM compositor is preserved\n• Existing continuous RTMP / DVB UDP / DVB SRT writer sessions are preserved\n• Normal scheduled/file TAKE automatically releases LIVE input" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="FfmpegText" VerticalAlignment="Center" Foreground="#7890A5"/><Button DockPanel.Dock="Right" Width="90" Height="32" Content="CLOSE" Click="Close_Click"/></DockPanel>
 </Grid>
</Window>
