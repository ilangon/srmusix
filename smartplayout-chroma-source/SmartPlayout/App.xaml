<Application x:Class="FFmpegNativePlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- SMART PLAYOUT modern broadcast-console palette -->
  <SolidColorBrush x:Key="AppBg" Color="#0B1017"/>
  <SolidColorBrush x:Key="PanelBg" Color="#121A24"/>
  <SolidColorBrush x:Key="PanelEdge" Color="#2D4055"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F3F7FB"/>
  <SolidColorBrush x:Key="TextMuted" Color="#90A4B8"/>

  <!-- Raised 3D / Fluent-style compact button -->
  <Style x:Key="Modern3DButton" TargetType="Button">
   <Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="36"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Padding" Value="10,3"/>
   <Setter Property="Foreground" Value="#F7FAFD"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="Shadow" CornerRadius="8" Margin="1,3,1,0" Background="#88000000"/>
       <Border x:Name="Surface" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
               BorderBrush="#4C6077">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#3A4758" Offset="0"/>
          <GradientStop Color="#263241" Offset="0.52"/>
          <GradientStop Color="#1B2531" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
        <Grid>
         <Border Height="1" VerticalAlignment="Top" Margin="7,2,7,0" Background="#75FFFFFF" CornerRadius="1"/>
         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Grid>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#6EA8D9"/>
        <Setter TargetName="Surface" Property="Background">
         <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#4B6076" Offset="0"/>
           <GradientStop Color="#30465B" Offset="0.52"/>
           <GradientStop Color="#213447" Offset="1"/>
          </LinearGradientBrush>
         </Setter.Value>
        </Setter>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Shadow" Property="Margin" Value="1,1,1,0"/>
        <Setter TargetName="Surface" Property="Margin" Value="0,2,0,0"/>
        <Setter TargetName="Surface" Property="Background" Value="#18232F"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="ModernIconButton" TargetType="Button" BasedOn="{StaticResource Modern3DButton}">
   <Setter Property="Width" Value="38"/>
   <Setter Property="MinWidth" Value="38"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
   <Setter Property="FontSize" Value="15"/>
  </Style>

  <Style x:Key="IconBlue3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#79C8FF"/>
  </Style>
  <Style x:Key="IconGreen3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#79F0A7"/>
  </Style>
  <Style x:Key="IconAmber3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#FFD36A"/>
  </Style>
  <Style x:Key="IconRed3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#FF7D8B"/>
  </Style>
  <Style x:Key="IconPurple3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#C89BFF"/>
  </Style>
  <Style x:Key="IconCyan3D" TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
   <Setter Property="Foreground" Value="#63E7E5"/>
  </Style>

  <Style x:Key="OnAir3DButton" TargetType="Button" BasedOn="{StaticResource Modern3DButton}">
   <Setter Property="Height" Value="48"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="Shadow" CornerRadius="10" Margin="1,4,1,0" Background="#90000000"/>
       <Border x:Name="Surface" CornerRadius="10" BorderThickness="1" BorderBrush="#FF6E7B">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#E84D5B" Offset="0"/>
          <GradientStop Color="#B51F33" Offset="0.55"/>
          <GradientStop Color="#791321" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
        <Grid>
         <Border Height="2" VerticalAlignment="Top" Margin="10,3,10,0" Background="#A8FFFFFF" CornerRadius="2"/>
         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#FFB4BC"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="Margin" Value="0,3,0,0"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#EC17202B"/>
   <Setter Property="Foreground" Value="#F3F7FB"/>
   <Setter Property="BorderBrush" Value="#48627D"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,5"/>
  </Style>
 </Application.Resources>
</Application>
