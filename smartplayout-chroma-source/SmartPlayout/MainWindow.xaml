       <StackPanel>
        <TextBlock Text="FINAL PROGRAM OUTPUT PATH" Foreground="#69F0C5" FontWeight="Bold"/>
        <TextBlock Text="These outputs follow the same Final Program picture used by the confidence monitor and streaming bus. Playlist clip changes do not reopen the physical display output." Foreground="#9FB0C0" TextWrapping="Wrap" Margin="0,3,0,0"/>
