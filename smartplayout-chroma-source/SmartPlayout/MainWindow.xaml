      <DockPanel Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="BROADCAST OUTPUT" FontSize="22" FontWeight="Bold" Foreground="#8EDCFF"/>
        <TextBlock Text="Final Program physical display / card outputs" Foreground="#8EA5BA" Margin="0,3,0,0"/>
       </StackPanel>
       <Button DockPanel.Dock="Right" Width="150" Height="34" Content="↻  REFRESH DEVICES" Click="OutputRefresh_Click" ToolTip="Refresh graphics-card displays and broadcast-output capabilities"/>
