       <Border Grid.Column="2" Background="#111B27" BorderBrush="#7657A8" BorderThickness="1.4" CornerRadius="12" Padding="18">
        <StackPanel>
         <DockPanel Margin="0,0,0,4" LastChildFill="False">
          <StackPanel>
           <TextBlock Text="BLACKMAGIC DECKLINK OUTPUT" FontSize="17" FontWeight="Bold" Foreground="#D8B9FF"/>
           <TextBlock Text="Native DeckLink SDK hardware routing" Foreground="#8EA5BA" FontSize="10"/>
