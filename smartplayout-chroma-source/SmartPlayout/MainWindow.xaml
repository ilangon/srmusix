<Window x:Class="FFmpegNativePlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FFmpegNativePlayer"
 Title="SMART PLAYOUT — v0.6.8.50.57 Complete CG Studio" Width="1500" Height="900" MinWidth="1180" MinHeight="700"
 Background="#0B1017" Foreground="#E8EDF5" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource Modern3DButton}"/>
  <Style x:Key="MainBlueIcon" TargetType="Button" BasedOn="{StaticResource IconBlue3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="MainGreenIcon" TargetType="Button" BasedOn="{StaticResource IconGreen3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="MainAmberIcon" TargetType="Button" BasedOn="{StaticResource IconAmber3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="MainRedIcon" TargetType="Button" BasedOn="{StaticResource IconRed3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="MainPurpleIcon" TargetType="Button" BasedOn="{StaticResource IconPurple3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="MainCyanIcon" TargetType="Button" BasedOn="{StaticResource IconCyan3D}"><Setter Property="FontFamily" Value="Segoe UI"/></Style>

  <!-- Modern dark broadcast-console navigation with semantic 3D identity -->
  <Style x:Key="NavBase3D" TargetType="Button" BasedOn="{StaticResource Modern3DButton}">
   <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="3,2"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="NavOnAir3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#FF7D8B"/></Style>
  <Style x:Key="NavInstant3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#79C8FF"/></Style>
  <Style x:Key="NavProgram3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#C89BFF"/></Style>
  <Style x:Key="NavScheduler3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#FFD36A"/></Style>
  <Style x:Key="NavFiller3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#79F0A7"/></Style>
  <Style x:Key="NavCg3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#C89BFF"/></Style>
  <Style x:Key="NavOutput3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#63E7E5"/></Style>
  <Style x:Key="NavSettings3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#9FD9FF"/></Style>
  <Style x:Key="NavScreen3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#8EDCFF"/></Style>
  <Style x:Key="NavStream3D" TargetType="Button" BasedOn="{StaticResource NavBase3D}"><Setter Property="Foreground" Value="#5FE6C8"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EDF5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0C131C"/><Setter Property="Foreground" Value="#F3F7FB"/><Setter Property="BorderBrush" Value="#33485D"/><Setter Property="CaretBrush" Value="#79C8FF"/></Style>
  <!-- STREAM UI: own ComboBox template so Windows themes cannot turn the field white / hide the selected codec. -->
  <Style x:Key="StreamComboItem" TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F4F8FC"/><Setter Property="Background" Value="#0E1822"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#24506A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#16747D"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9FB1C2"/><Setter Property="Opacity" Value="0.82"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StreamComboBox" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#111F2B"/><Setter Property="BorderBrush" Value="#45647D"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ItemContainerStyle" Value="{StaticResource StreamComboItem}"/>
   <Setter Property="MaxDropDownHeight" Value="300"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid SnapsToDevicePixels="True">
       <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
       <Grid Margin="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
        <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="5,2,2,2" Visibility="Hidden" Background="#111F2B" Foreground="#FFFFFF"
                 BorderThickness="0" CaretBrush="#63E7E5" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                 VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
        <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
         <Grid><Path Width="10" Height="6" Stretch="Fill" Fill="#8EDCFF" Data="M 0 0 L 5 5 L 10 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </ToggleButton>
       </Grid>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border x:Name="DropDownBorder" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                Background="#0A141D" BorderBrush="#4B718B" BorderThickness="1" CornerRadius="5">
         <ScrollViewer Margin="2" MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEditable" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#63E7E5"/><Setter TargetName="FieldBorder" Property="BorderThickness" Value="2"/></Trigger>
       <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="FieldBorder" Property="Background" Value="#162B3A"/><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#63E7E5"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FieldBorder" Property="Background" Value="#17212B"/><Setter Property="Foreground" Value="#C3D0DC"/><Setter Property="Opacity" Value="0.88"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="StreamBitrateCombo" TargetType="ComboBox" BasedOn="{StaticResource StreamComboBox}">
   <Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="MaxDropDownHeight" Value="280"/>
  </Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F6FAE"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#121C27" CornerRadius="7" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="SMART PLAYOUT" FontSize="21" FontWeight="Bold" Foreground="#F5F9FD" VerticalAlignment="Center"/><TextBlock Text="  •  MODERN BROADCAST CONSOLE" Foreground="#63E7E5" VerticalAlignment="Center"/></StackPanel>
    <TextBlock x:Name="StatusText" Text="READY" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#0E1721" BorderBrush="#253B50" BorderThickness="1" CornerRadius="7" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource NavOnAir3D}" Click="DashboardNav_Click" ToolTip="MAIN — live confidence monitoring and playout control"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="MAIN"/></StackPanel></Button>
     <Button Style="{StaticResource NavInstant3D}" Click="InstantNav_Click" ToolTip="INSTANT PLAYLIST — instant media workspace"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="INSTANT PLAYLIST"/></StackPanel></Button>
     <Button Style="{StaticResource NavProgram3D}" Click="ProgramManager_Click" ToolTip="PROGRAM — integrated Program workspace"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="PROGRAM"/></StackPanel></Button>
     <Button Style="{StaticResource NavScheduler3D}" Click="SchedulerNav_Click" ToolTip="SCHEDULER — integrated scheduling workspace"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="SCHEDULER"/></StackPanel></Button>
     <Button Style="{StaticResource NavFiller3D}" Click="FillerNav_Click" ToolTip="FILLER — default / fallback playout"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="FILLER"/></StackPanel></Button>
     <Button Style="{StaticResource NavCg3D}" Click="MixerNav_Click" ToolTip="AUDIO MIXER — dedicated Final Program audio controls"><StackPanel Orientation="Horizontal"><TextBlock Text="MIX" FontSize="9" FontWeight="Bold" Foreground="#FFD36A" Margin="0,0,7,0"/><TextBlock Text="MIXER"/></StackPanel></Button>
     <Button Style="{StaticResource NavCg3D}" Click="LiveNav_Click" ToolTip="LIVE INPUT — capture device selection and TAKE TO AIR"><StackPanel Orientation="Horizontal"><TextBlock Text="IN" FontSize="9" FontWeight="Bold" Foreground="#69F0C5" Margin="0,0,7,0"/><TextBlock Text="LIVE"/></StackPanel></Button>
     <Button Style="{StaticResource NavCg3D}" Click="BreakNav_Click" ToolTip="BREAK / ADS — dedicated commercial break manager"><StackPanel Orientation="Horizontal"><TextBlock Text="AD" FontSize="9" FontWeight="Bold" Foreground="#FFB36A" Margin="0,0,7,0"/><TextBlock Text="BREAK"/></StackPanel></Button>
     <Button Style="{StaticResource NavCg3D}" Click="KeyerNav_Click" ToolTip="CHROMA KEYER — dedicated key preview canvas"><StackPanel Orientation="Horizontal"><TextBlock Text="KEY" FontSize="9" FontWeight="Bold" Foreground="#79F0A7" Margin="0,0,7,0"/><TextBlock Text="KEYER"/></StackPanel></Button>
     <Button Style="{StaticResource NavCg3D}" Click="CgNav_Click" ToolTip="CG STUDIO — lower thirds, tickers, logos and graphics"><StackPanel Orientation="Horizontal"><TextBlock Text="CG" FontSize="9" FontWeight="Bold" Foreground="#E7B5FF" Margin="0,0,7,0"/><TextBlock Text="CG STUDIO"/></StackPanel></Button>
     <Button Style="{StaticResource NavOutput3D}" Click="PlayoutPlusNav_Click" ToolTip="PLAYOUT+ — Medialooks parity / low-level playout stage"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="PLAYOUT+"/></StackPanel></Button>
     <Button Style="{StaticResource NavOutput3D}" Click="OutputNav_Click" ToolTip="OUTPUT — broadcast output"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="OUTPUT"/></StackPanel></Button>
     <Button Style="{StaticResource NavStream3D}" Click="StreamNav_Click" ToolTip="STREAM — streaming workspace"><StackPanel Orientation="Horizontal"><TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#5FE6C8" Margin="0,0,7,0"/><TextBlock Text="STREAM"/></StackPanel></Button>
     <Button Style="{StaticResource NavScreen3D}" Click="ScreenNav_Click" ToolTip="SCREEN — display and resolution workspace"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="SCREEN"/></StackPanel></Button>
     <Button Style="{StaticResource NavSettings3D}" Click="SettingsNav_Click" ToolTip="SETTINGS — application settings"><StackPanel Orientation="Horizontal"><TextBlock Text="SET" FontSize="10" FontWeight="Bold" Foreground="#9FD9FF" Margin="0,0,7,0"/><TextBlock Text="SETTINGS"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SOURCE  " Foreground="#8295A8"/><TextBlock x:Name="NavCurrentSourceText" Text="IDLE" FontWeight="Bold" Foreground="#63E7E5"/></StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2">
   <!-- ON AIR DASHBOARD: source/program/schedule/filler confidence monitoring -->
   <Grid x:Name="OnAirWorkspace" Visibility="Visible">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="#0D151F" BorderBrush="#36536F" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
     <Grid Margin="6">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="230"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/><ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- CURRENT / NOW card -->
      <Border Grid.Column="0" Background="#182538" BorderBrush="#4D79A3" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0">
       <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#020406" CornerRadius="4" Width="68" Height="48" VerticalAlignment="Center"><Grid><Image x:Name="NowThumbImage" Stretch="UniformToFill"/><TextBlock Text="ON" Foreground="#5FE6A2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"/></Grid></Border>
        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="#83D8FF"/>
         <TextBlock x:Name="NowText" Text="—" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="Current on-air item"/>
         <TextBlock x:Name="NowProgramInfoText" Text="PROGRAM —" FontSize="9.5" Foreground="#C9D6E3" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="NowDescriptionText" Text="DESCRIPTION —" FontSize="9.5" Foreground="#AFC7DA" TextTrimming="CharacterEllipsis"/>
         <StackPanel Orientation="Horizontal"><TextBlock x:Name="CurrentSourceText" Text="IDLE" FontSize="9.5" Foreground="#63E7E5" FontWeight="SemiBold"/><TextBlock Text="  •  "/><TextBlock x:Name="NowAudioText" Text="AUDIO —" FontSize="9.5" Foreground="#E7C85C"/></StackPanel>
        </StackPanel>
       </Grid>
      </Border>

      <!-- NEXT card -->
      <Border Grid.Column="1" Background="#182538" BorderBrush="#725EAE" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0">
       <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#020406" CornerRadius="4" Width="68" Height="48" VerticalAlignment="Center"><Grid><Image x:Name="NextThumbImage" Stretch="UniformToFill"/><TextBlock Text="▶" Foreground="#B7A7FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/></Grid></Border>
        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="NEXT PLAYING" FontSize="10" FontWeight="Bold" Foreground="#B7A7FF"/>
         <TextBlock x:Name="NextText" Text="—" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="Next queued item"/>
         <TextBlock x:Name="NextProgramInfoText" Text="PROGRAM —" FontSize="9.5" Foreground="#C9D6E3" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="NextDescriptionText" Text="DESCRIPTION —" FontSize="9.5" Foreground="#AFC7DA" TextTrimming="CharacterEllipsis"/>
         <StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusNextTypeText" Text="QUEUE / SCHEDULE" FontSize="9.5" Foreground="#8EA5BA"/><TextBlock Text="  •  "/><TextBlock x:Name="NextAudioText" Text="AUDIO —" FontSize="9.5" Foreground="#E7C85C"/></StackPanel>
        </StackPanel>
       </Grid>
      </Border>

      <!-- Central status -->
      <Border Grid.Column="2" Background="#131E2A" BorderBrush="#2B435A" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0">
       <Grid Margin="8,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="StatusNowNextText" Text="NOW: —" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F1F6FB"/>
        <TextBlock Grid.Row="1" x:Name="StatusScheduleLineText" Text="NEXT: —" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#AFC7DA"/>
        <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="StatusElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#70D7FF" VerticalAlignment="Center"/>
         <ProgressBar x:Name="StatusPlayProgress" Grid.Column="1" Height="7" Margin="10,0" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
         <TextBlock x:Name="StatusRemainingText" Grid.Column="2" Text="REM 00:00:00" FontFamily="Consolas" FontSize="12" Foreground="#FFD56A" VerticalAlignment="Center"/>
         <TextBlock x:Name="StatusTotalText" Grid.Column="3" Text="  TOT 00:00:00" FontFamily="Consolas" FontSize="12" Foreground="#9FD9FF" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="HeaderCurrentScheduleText" Text="CURRENT SCHEDULE —" FontSize="9.5" Foreground="#7EE2AC" TextTrimming="CharacterEllipsis"/>
         <TextBlock Grid.Column="1" x:Name="HeaderNextScheduleText" Text="NEXT SCHEDULE —" FontSize="9.5" Foreground="#9FD9FF" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
        </Grid>
       </Grid>
      </Border>

      <!-- Primary transport + master audio. ON AIR controls live here only. -->
      <Border Grid.Column="3" Background="#131E2A" BorderBrush="#2B435A" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Button Style="{StaticResource MainBlueIcon}" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" ToolTip="Previous item in active source" Click="StatusPrevious_Click"/>
         <Button Style="{StaticResource MainGreenIcon}" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" ToolTip="Play / Resume Program" Click="ProgramPlay_Click"/>
         <Button Style="{StaticResource MainAmberIcon}" Content="&#xE769;" FontFamily="Segoe MDL2 Assets" ToolTip="Pause / Resume Program" Click="ProgramPause_Click"/>
         <Button Style="{StaticResource MainRedIcon}" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" ToolTip="Stop Program" Click="ProgramStop_Click"/>
         <Button Style="{StaticResource MainBlueIcon}" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" ToolTip="Next item in active source" Click="StatusNext_Click"/>
         <Button Style="{StaticResource MainCyanIcon}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTip="Return to current Schedule" Click="ReturnToSchedule_Click"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="2,3,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
         <Button x:Name="MasterMuteButton" Style="{StaticResource MainPurpleIcon}" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" Width="30" Height="28" ToolTip="Mute Master On-Air Audio" Click="MasterMute_Click"/>
         <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Margin="6,0" VerticalAlignment="Center" ValueChanged="MasterVolumeSlider_ValueChanged" ToolTip="Master On-Air Volume"/>
         <TextBlock x:Name="MasterVolumeText" Grid.Column="2" Text="100%" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"><TextBlock Text="AUTOMATION  " Foreground="#8295A8" FontSize="9.5"/><TextBlock x:Name="FillerStatusText" Text="FILLER STANDBY" Foreground="#E7C85C" FontWeight="SemiBold" FontSize="9.5"/></StackPanel>
       </Grid>
      </Border>

      <!-- Clock / CPU / ON AIR master state: aligned two-row operator card -->
      <Border Grid.Column="4" Background="#131E2A" BorderBrush="#2B435A" BorderThickness="1" CornerRadius="7">
       <Grid Margin="8,4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
         <TextBlock x:Name="StatusClockText" Text="00:00:00" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#F2F6FA" HorizontalAlignment="Center"/>
         <TextBlock x:Name="StatusDateText" Text="—" FontSize="10" Foreground="#9FB0C0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
         <TextBlock Text="CPU" Foreground="#8EA5BA" FontSize="9.5" HorizontalAlignment="Center"/>
         <TextBlock x:Name="StatusCpuText" Text="0%" FontFamily="Consolas" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
         <ProgressBar x:Name="StatusCpuBar" Minimum="0" Maximum="100" Height="6" Value="0"/>
        </StackPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0B121A" BorderBrush="#2C475E" BorderThickness="1" CornerRadius="5" Margin="0,4,0,0" Padding="4,2">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Ellipse x:Name="OnAirLed" Width="11" Height="11" Fill="#52F28C" Stroke="#B7FFD0" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Effect><DropShadowEffect Color="#52F28C" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect></Ellipse>
          <Button x:Name="OnAirPowerButton" Height="27" MinWidth="82" Padding="7,2" Style="{StaticResource MainGreenIcon}" FontFamily="Segoe UI" Click="OnAirPower_Click" ToolTip="AIR ON / OFF — OFF gives full black output"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="OnAirPowerText" Text="AIR ON" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Button>
         </StackPanel>
        </Border>
       </Grid>
      </Border>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="#101923" CornerRadius="7" Margin="0,0,8,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="310"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,7"><TextBlock Text="ON AIR / PROGRAM CONFIDENCE MONITOR" FontWeight="Bold" FontSize="15" Foreground="#67E8A5"/><TextBlock x:Name="ProgramTimeText" DockPanel.Dock="Right" Text="00:00 / 00:00" Foreground="#B7C2D0"/></DockPanel>
      <Grid Grid.Row="1">
       <Border Background="#030507" BorderBrush="#4C769B" BorderThickness="2" CornerRadius="6" HorizontalAlignment="Left" Width="550">
        <Grid>
         <Image x:Name="ProgramImage" Stretch="Fill"/>
         <Grid x:Name="ProgramStateOverlay" Panel.ZIndex="20" Visibility="Collapsed" Background="#05070A">
          <Grid x:Name="StandbySlate">
