         </Border>

         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="DeckLinkStartButton" Width="128" Height="38" Content="▶  START OUTPUT" Click="DeckLinkOutputStart_Click" IsEnabled="False" ToolTip="Start only after native bridge, card, physical output and supported mode are all valid"/>
