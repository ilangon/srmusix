          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="3  VIDEO MODE / FRAME RATE • DEFAULT AUTO" FontSize="10" Foreground="#7F94A8" FontWeight="SemiBold"/>
           <ComboBox x:Name="DeckLinkModeCombo" Style="{StaticResource StreamComboBox}" Height="36" Margin="0,5,0,0" IsEnabled="False" ToolTip="AUTO / MAIN OUTPUT follows the applied SCREEN resolution, FPS and scan. Manual supported DeckLink modes remain available below it."/>
          </StackPanel>
         </Grid>

         <Border Background="#0B151E" BorderBrush="#314658" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="PIXEL FORMAT" FontSize="9" Foreground="#6F8497"/><TextBlock Text="8-BIT YUV 4:2:2 (UYVY)" Foreground="#C9D8E5" FontWeight="SemiBold"/></StackPanel>
           <StackPanel Grid.Column="1"><TextBlock Text="AUDIO" FontSize="9" Foreground="#6F8497"/><TextBlock Text="48 kHz PCM • 2 CH EMBEDDED" Foreground="#C9D8E5" FontWeight="SemiBold"/></StackPanel>
