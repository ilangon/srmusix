         <TextBlock x:Name="DeckLinkOutputStatusText" Text="STOPPED" Foreground="#69F0C5" FontWeight="SemiBold" Margin="0,3,0,8" TextWrapping="Wrap"/>
         <TextBlock Text="SDK / DEVICE STATUS" FontSize="9" Foreground="#7F94A8"/>
         <TextBlock x:Name="DeckLinkStatusText" Text="REFRESH TO DETECT" Foreground="#FFD36A" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="10"/>
         <Border Background="#0A121A" BorderBrush="#3B4E60" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,12,0,0">
          <TextBlock Text="Hardware mode is independent of the preview window size. Final Program is scaled/padded to the selected DeckLink raster. START remains locked until bridge + card + physical output + mode are valid." Foreground="#8EA5BA" TextWrapping="Wrap" FontSize="9.5"/>
         </Border>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </Border>

