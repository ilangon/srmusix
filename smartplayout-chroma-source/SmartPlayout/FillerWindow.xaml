<Window x:Class="FFmpegNativePlayer.FillerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SMART PLAYOUT — Filler / Fallback" Width="760" Height="560" MinWidth="620" MinHeight="440" Background="#0B1017" Foreground="#E8EDF5" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource Modern3DButton}"/></Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#121C27" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="FILLER / DEFAULT FALLBACK" FontSize="20" FontWeight="Bold" Foreground="#67E8A5"/><TextBlock Text="Used automatically only when no manual, Instant Playlist or scheduled Program has content to play." Foreground="#9FB0C2" Margin="0,4,0,0"/></StackPanel></Border>
  <WrapPanel Grid.Row="1" Margin="0,10,0,8"><Button Content="＋  ADD FILES" Click="Add_Click"/><Button Content="↑  UP" Click="Up_Click"/><Button Content="↓  DOWN" Click="Down_Click"/><Button Content="✕  REMOVE" Click="Remove_Click"/><Button Content="⌫  CLEAR" Click="Clear_Click"/></WrapPanel>
  <ListBox x:Name="FilesList" Grid.Row="2" Background="#090E14" Foreground="White" BorderBrush="#30465C" FontSize="14"/>
  <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#9FB0C2"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="CANCEL" IsCancel="True"/><Button Content="✓  SAVE FILLER" Click="Save_Click" Foreground="#67E8A5"/></StackPanel></DockPanel>
 </Grid>
</Window>
