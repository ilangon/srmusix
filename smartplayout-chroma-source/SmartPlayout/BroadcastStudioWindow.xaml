<Window x:Class="FFmpegNativePlayer.BroadcastStudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SMART PLAYOUT • CG DESIGNER" Width="1380" Height="840" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterOwner" Background="#0B1118" Foreground="#F4F8FC">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111F2B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#45647D"/><Setter Property="CaretBrush" Value="#63E7E5"/><Setter Property="Padding" Value="6,4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#111F2B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#45647D"/></Style>
  <Style x:Key="Action" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Background" Value="#17344A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B718B"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0F1A24"/><Setter Property="BorderBrush" Value="#2E485E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
 </Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="True"><StackPanel Width="320"><TextBlock FontSize="24" FontWeight="Bold"><Run Text="SMART PLAYOUT • "/><Run Text="CG STUDIO" Foreground="#21A9E8"/></TextBlock><TextBlock Text="CREATE  •  DESIGN  •  PLAYOUT  •  LIVE" Foreground="#71879B"/></StackPanel><Border Background="#102B21" BorderBrush="#23BD65" BorderThickness="1" CornerRadius="4" Padding="18,8" Margin="8,0"><TextBlock Text="●  PROGRAM ON AIR" Foreground="#37E77D" FontWeight="Bold"/></Border><StackPanel Orientation="Horizontal" Margin="18,0,0,0"><TextBlock Text="1080p50&#x0a;HD" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Width="150" Margin="25,0"><TextBlock Text="AUDIO   L" Foreground="#9FB0C0"/><ProgressBar x:Name="CgAudioL" Height="7" Maximum="1" Foreground="#25D969" Background="#182B39"/><TextBlock Text="             R" Foreground="#9FB0C0"/><ProgressBar x:Name="CgAudioR" Height="7" Maximum="1" Foreground="#E4C327" Background="#182B39"/></StackPanel><TextBlock x:Name="CgHeaderClock" Text="00:00:00" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="22,0,0,0"><TextBlock x:Name="CgStatus" Text="READY" Foreground="#8EA5BA" TextAlignment="Right"/><TextBlock Text="⚙  Settings" Foreground="#D5E4F2" TextAlignment="Right"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="CG ELEMENTS" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
    <Button Style="{StaticResource Action}" Content="TEXT WATERMARK" Background="#0C6478" BorderBrush="#63E7E5" Click="FocusWatermark_Click"/><Button Style="{StaticResource Action}" Content="TEXT / TITLE" Click="FocusText_Click"/><Button Style="{StaticResource Action}" Content="LOWER THIRD" Click="FocusLower_Click"/><Button Style="{StaticResource Action}" Content="LOGO / IMAGE" Click="FocusLogo_Click"/><Button Style="{StaticResource Action}" Content="SCROLL TICKER" Click="FocusMove_Click"/><Button Style="{StaticResource Action}" Content="VERTICAL ROLL" Click="FocusMove_Click"/><Button Style="{StaticResource Action}" Content="CLOCK / TIMER" Click="FocusClock_Click"/><Button Style="{StaticResource Action}" Content="NOW / NEXT" Click="FocusNow_Click"/><Button Style="{StaticResource Action}" Content="SHAPE" Click="FocusShape_Click"/><Button Style="{StaticResource Action}" Content="L-SHAPE" Click="FocusShape_Click"/><Button Style="{StaticResource Action}" Content="FULL SCREEN GRAPHIC" Click="FocusFull_Click"/><Button Style="{StaticResource Action}" Content="MOVING VIDEO PIP" Click="FocusPip_Click"/><Button Style="{StaticResource Action}" Content="IMAGE SEQUENCE" Click="FocusSequence_Click"/>
    <Separator Margin="0,10"/><Button Style="{StaticResource Action}" Content="REFRESH PROGRAM PREVIEW" Click="RefreshPreview_Click"/><Button Style="{StaticResource Action}" Content="SAVE CG PROFILE" Click="SaveProfile_Click"/><Button Style="{StaticResource Action}" Content="LOAD CG PROFILE" Click="LoadProfile_Click"/><Button Style="{StaticResource Action}" Content="CLEAR ADVANCED CG" Click="ClearAdvanced_Click"/>
   </StackPanel></ScrollViewer></Border>

   <Grid Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.45*"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="CG CANVAS / PREVIEW" FontWeight="Bold" Foreground="#83D8FF"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="View:" VerticalAlignment="Center" Foreground="#9FB0C0"/><ComboBox Width="120" SelectedIndex="0" Margin="5,0,8,0"><ComboBoxItem Content="Program (Clean)"/><ComboBoxItem Content="Program + CG"/></ComboBox><ComboBox Width="65" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="4:3"/></ComboBox><ComboBox Width="75" SelectedIndex="0"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="100%"/></ComboBox></StackPanel></DockPanel>
    <Border Grid.Row="1" Margin="0,8,0,4" Background="Black" BorderBrush="#45647D" BorderThickness="1"><Viewbox Stretch="Uniform"><Grid Width="960" Height="540" Background="Black"><Image x:Name="ProgramPreview" Stretch="Uniform"/><Canvas x:Name="CgCanvas" Width="960" Height="540" Background="Transparent" MouseLeftButtonDown="CgCanvas_MouseLeftButtonDown" MouseMove="CgCanvas_MouseMove" MouseLeftButtonUp="CgCanvas_MouseLeftButtonUp"/></Grid></Viewbox></Border>
    <DockPanel Grid.Row="2" Margin="0,0,0,5"><Button Style="{StaticResource Action}" Background="#168B3D" Content="▶  PREVIEW (SPACE)" Click="PreviewAll_Click"/><Button Style="{StaticResource Action}" Content="■  STOP" Click="StopPreview_Click"/><TextBlock DockPanel.Dock="Right" x:Name="CgTimelineClock" Text="00:00:00 / 00:00:30" Foreground="#9FB0C0" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="3" Background="#0F1A24" BorderBrush="#2E485E" BorderThickness="1" CornerRadius="5" Padding="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="LAYERS &amp; TIMELINE" FontWeight="Bold" Foreground="#D5E4F2"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource Action}" Width="34" Content="↑" ToolTip="Layer Up" Click="SelectedLayerUp_Click"/><Button Style="{StaticResource Action}" Width="34" Content="↓" ToolTip="Layer Down" Click="SelectedLayerDown_Click"/><Button Style="{StaticResource Action}" Width="34" Content="⧉" ToolTip="Duplicate Layer" Click="DuplicateLayer_Click"/><Button Style="{StaticResource Action}" Width="34" Content="🗑" ToolTip="Delete Layer" Click="DeleteLayer_Click"/></StackPanel></DockPanel><ListView Grid.Row="1" x:Name="LayerList" Background="#0B131C" Foreground="White" BorderThickness="0" SelectionChanged="LayerList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="#" Width="35" DisplayMemberBinding="{Binding Order}"/><GridViewColumn Header="Layer Name" Width="145" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Visible" Width="55"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}" HorizontalAlignment="Center" Click="LayerVisible_Click"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Lock" Width="45"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Locked}" HorizontalAlignment="Center" Click="LayerLock_Click"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Start" Width="70"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding StartText,UpdateSourceTrigger=PropertyChanged}" Padding="2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Duration" Width="75"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding DurationText,UpdateSourceTrigger=PropertyChanged}" Padding="2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Timeline 00:00 → 00:30" Width="170"><GridViewColumn.CellTemplate><DataTemplate><Border Height="12" Margin="3" Background="{Binding BarBrush}" CornerRadius="2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></Grid></Border>
   </Grid>

   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border x:Name="WatermarkCard" Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="TEXT WATERMARK PROPERTIES" FontWeight="Bold" Foreground="#63E7E5" FontSize="16"/>
     <TextBlock Text="WATERMARK TEXT" Foreground="#9FB0C0" Margin="0,10,0,3"/><TextBox x:Name="WatermarkText" Text="SR MUSIC" TextChanged="WatermarkPreviewChanged"/>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,7,0"><TextBlock Text="FONT" Foreground="#9FB0C0"/><ComboBox x:Name="WatermarkFont" SelectedIndex="0" SelectionChanged="WatermarkPreviewChanged"><ComboBoxItem Content="Segoe UI Semibold"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Arial Black"/><ComboBoxItem Content="Roboto"/><ComboBoxItem Content="Tahoma"/><ComboBoxItem Content="Times New Roman"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="STYLE" Foreground="#9FB0C0"/><ComboBox x:Name="WatermarkStyle" SelectedIndex="1" SelectionChanged="WatermarkPreviewChanged"><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Bold"/><ComboBoxItem Content="Italic"/><ComboBoxItem Content="Bold Italic"/></ComboBox></StackPanel>
     </Grid>
     <TextBlock Text="TEXT COLOR" Foreground="#9FB0C0" Margin="0,8,0,3"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Action}" Margin="6,0,0,0" Content="CHOOSE" Click="ChooseWatermarkColor_Click"/><Border x:Name="WatermarkColorSwatch" Width="34" Background="White" BorderBrush="#45647D" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,6,0"/><TextBox x:Name="WatermarkColor" Text="#FFFFFF" TextChanged="WatermarkPreviewChanged"/></DockPanel>
     <UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="OPACITY %" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkOpacity" Text="45" TextChanged="WatermarkPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="FONT SIZE" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkSize" Text="42" TextChanged="WatermarkPreviewChanged"/></StackPanel></UniformGrid>
     <TextBlock Text="TRANSFORM • MOUSE MOVE / CORNER RESIZE" Foreground="#63E7E5" FontWeight="Bold" Margin="0,11,0,2"/>
     <UniformGrid Columns="2" Margin="0,5,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="POSITION X %" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkX" Text="82" TextChanged="WatermarkPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="POSITION Y %" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkY" Text="8" TextChanged="WatermarkPreviewChanged"/></StackPanel></UniformGrid>
     <UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="SCALE %" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkScale" Text="100" TextChanged="WatermarkPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="ROTATION °" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkRotation" Text="0" TextChanged="WatermarkPreviewChanged"/></StackPanel></UniformGrid>
     <UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="OUTLINE px" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkOutline" Text="1" TextChanged="WatermarkPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="LAYER" Foreground="#9FB0C0"/><TextBox x:Name="WatermarkLayer" Text="180" IsReadOnly="True"/></StackPanel></UniformGrid>
     <WrapPanel Margin="0,9,0,3"><CheckBox x:Name="WatermarkShadow" Content="SHADOW" IsChecked="True" Foreground="White" Margin="0,0,12,5" Checked="WatermarkPreviewChanged" Unchecked="WatermarkPreviewChanged"/><CheckBox x:Name="WatermarkLockAspect" Content="LOCK ASPECT" IsChecked="True" Foreground="White" Margin="0,0,12,5"/><CheckBox x:Name="WatermarkSafeArea" Content="SAFE AREA" IsChecked="True" Foreground="White" Checked="WatermarkPreviewChanged" Unchecked="WatermarkPreviewChanged"/><CheckBox x:Name="WatermarkAlwaysOn" Content="ALWAYS ON AFTER RESTART" Foreground="#69F0C5" Margin="0,0,0,5"/></WrapPanel>
     <WrapPanel><Button Style="{StaticResource Action}" Content="LAYER UP" Click="WatermarkLayerUp_Click"/><Button Style="{StaticResource Action}" Content="LAYER DOWN" Click="WatermarkLayerDown_Click"/><Button Style="{StaticResource Action}" Content="PREVIEW" Click="PreviewWatermark_Click"/><Button Style="{StaticResource Action}" Content="RESET" Click="ResetWatermark_Click"/></WrapPanel>
     <WrapPanel Margin="0,4,0,0"><Button Style="{StaticResource Action}" Content="SAVE WATERMARK" Click="SaveWatermark_Click"/><Button Style="{StaticResource Action}" Content="LOAD WATERMARK" Click="LoadWatermark_Click"/><Button Style="{StaticResource Action}" Content="HIDE" Click="HideWatermark_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearWatermark_Click"/></WrapPanel>
     <Button Height="42" Margin="0,6,0,0" Background="#E52E2E" Foreground="White" BorderBrush="#FF6B6B" FontWeight="Bold" FontSize="15" Content="TAKE / UPDATE" Click="TakeWatermark_Click"/>
    </StackPanel></Border>
    <Border x:Name="TextCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEXT / TITLES" FontWeight="Bold"/><TextBox x:Name="CgText" Text="SMART PLAYOUT" Margin="0,6" TextChanged="PreviewTextChanged"/><UniformGrid Columns="3"><TextBox x:Name="CgX" Text="0.05"/><TextBox x:Name="CgY" Text="0.82"/><TextBox x:Name="CgSize" Text="36"/></UniformGrid><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Style="{StaticResource Action}" Content="TAKE PRIMARY" Click="TakePrimary_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearPrimary_Click"/></StackPanel><TextBox x:Name="Cg2Text" Text="SECONDARY TITLE" Margin="0,4"/><UniformGrid Columns="3"><TextBox x:Name="Cg2X" Text="0.05"/><TextBox x:Name="Cg2Y" Text="0.90"/><TextBox x:Name="Cg2Size" Text="24"/></UniformGrid><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Style="{StaticResource Action}" Content="TAKE SECONDARY" Click="TakeSecondary_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearSecondary_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="LowerCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOWER THIRD PROPERTIES" FontWeight="Bold" Foreground="#63E7E5" FontSize="16"/><TabControl Margin="0,8,0,0" Background="#0F1A24" Foreground="White"><TabItem Header="Content"><StackPanel Margin="8"><TextBlock Text="TEMPLATE NAME" Foreground="#83D8FF"/><TextBox x:Name="LowerTemplateName" Text="News Lower Third - Standard" Margin="0,4,0,10"/><TextBlock Text="MAIN TEXT" Foreground="#83D8FF"/><TextBox x:Name="LowerText" Text="SARAH MITCHELL" Margin="0,4,0,8" TextChanged="LowerPreviewChanged"/><TextBlock Text="SECONDARY TEXT" Foreground="#83D8FF"/><TextBox x:Name="LowerSecondaryText" Text="NEWS PRESENTER" Margin="0,4,0,8" TextChanged="LowerPreviewChanged"/></StackPanel></TabItem><TabItem Header="Style"><StackPanel Margin="8"><TextBlock Text="FONT FAMILY / SIZE" Foreground="#83D8FF"/><UniformGrid Columns="2" Margin="0,4,0,8"><ComboBox x:Name="LowerFont" SelectedIndex="0" SelectionChanged="LowerPreviewChanged"><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Roboto"/><ComboBoxItem Content="Tahoma"/></ComboBox><TextBox x:Name="LowerSize" Text="48" TextChanged="LowerPreviewChanged"/></UniformGrid><TextBlock Text="TEXT COLOR" Foreground="#83D8FF"/><TextBox x:Name="LowerTextColor" Text="#FFFFFF" Margin="0,4,0,8" TextChanged="LowerPreviewChanged"/><TextBlock Text="BACKGROUND COLOR / OPACITY %" Foreground="#83D8FF"/><UniformGrid Columns="2" Margin="0,4,0,0"><TextBox x:Name="LowerBackgroundColor" Text="#0B4ED7" TextChanged="LowerPreviewChanged"/><TextBox x:Name="LowerBackgroundOpacity" Text="90" TextChanged="LowerPreviewChanged"/></UniformGrid></StackPanel></TabItem><TabItem Header="Position"><StackPanel Margin="8"><TextBlock Text="POSITION &amp; SIZE (%)" Foreground="#83D8FF"/><UniformGrid Columns="2" Margin="0,5,0,0"><StackPanel><TextBlock Text="Position X"/><TextBox x:Name="LowerX" Text="0.05" TextChanged="LowerPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="Position Y"/><TextBox x:Name="LowerY" Text="0.75" TextChanged="LowerPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="Width"/><TextBox x:Name="LowerW" Text="0.60" TextChanged="LowerPreviewChanged"/></StackPanel><StackPanel><TextBlock Text="Height"/><TextBox x:Name="LowerH" Text="0.12" TextChanged="LowerPreviewChanged"/></StackPanel></UniformGrid><TextBlock Text="Move and resize directly in the CG canvas." Foreground="#9FB0C0" Margin="0,10,0,0"/></StackPanel></TabItem><TabItem Header="Animation"><StackPanel Margin="8"><TextBlock Text="ANIMATION IN" Foreground="#83D8FF"/><ComboBox x:Name="LowerAnimationIn" SelectedIndex="1" Margin="0,4,0,8"><ComboBoxItem Content="None"/><ComboBoxItem Content="Slide In Left"/><ComboBoxItem Content="Slide In Right"/><ComboBoxItem Content="Slide In Up"/><ComboBoxItem Content="Slide In Down"/><ComboBoxItem Content="Fade In"/></ComboBox><TextBlock Text="ANIMATION OUT" Foreground="#83D8FF"/><ComboBox x:Name="LowerAnimationOut" SelectedIndex="1" Margin="0,4,0,8"><ComboBoxItem Content="None"/><ComboBoxItem Content="Slide Out Left"/><ComboBoxItem Content="Slide Out Right"/><ComboBoxItem Content="Slide Out Up"/><ComboBoxItem Content="Slide Out Down"/><ComboBoxItem Content="Fade Out"/></ComboBox><TextBlock Text="DURATION (SEC)" Foreground="#83D8FF"/><TextBox x:Name="LowerAnimationDuration" Text="0.6" Margin="0,4,0,0"/></StackPanel></TabItem></TabControl><WrapPanel Margin="0,8,0,0"><Button Style="{StaticResource Action}" Background="#E52E2E" Content="TAKE / UPDATE LOWER THIRD" Click="TakeLower_Click"/><Button Style="{StaticResource Action}" Content="REMOVE FROM AIR" Click="RemoveLowerThird_Click"/></WrapPanel></StackPanel></Border>
    <Border x:Name="LogoCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOGO / IMAGE" FontWeight="Bold" Foreground="#63E7E5"/><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="BROWSE" Click="BrowseLogo_Click"/><TextBox x:Name="LogoPath" IsReadOnly="True"/></DockPanel><TextBlock Text="TRANSFORM • MOUSE MOVE / CORNER RESIZE" Foreground="#63E7E5" FontWeight="Bold" Margin="0,5,0,3"/><UniformGrid Columns="5"><TextBox x:Name="LogoX" Text="0.75" TextChanged="LogoPreviewChanged"/><TextBox x:Name="LogoY" Text="0.05" TextChanged="LogoPreviewChanged"/><TextBox x:Name="LogoW" Text="0.20" TextChanged="LogoPreviewChanged"/><TextBox x:Name="LogoH" Text="0.15" TextChanged="LogoPreviewChanged"/><TextBox x:Name="LogoOpacity" Text="1" TextChanged="LogoPreviewChanged"/></UniformGrid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="LogoStretch" SelectedIndex="0" SelectionChanged="LogoPreviewChanged"><ComboBoxItem Content="FIT / KEEP RATIO"/><ComboBoxItem Content="FULL STRETCH"/><ComboBoxItem Content="FILL / CROP"/></ComboBox><CheckBox Grid.Column="1" x:Name="LogoLockAspect" Content="LOCK ASPECT" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Style="{StaticResource Action}" Content="TAKE / UPDATE LOGO" Click="TakeLogo_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearLogo_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="MoveCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TICKER / VERTICAL ROLL" FontWeight="Bold"/><TextBox x:Name="MoveText" Text="BREAKING NEWS • SMART PLAYOUT" Margin="0,6"/><UniformGrid Columns="3"><TextBox x:Name="MoveAxis" Text="0.88"/><TextBox x:Name="MoveSize" Text="28"/><TextBox x:Name="MoveSpeed" Text="0.12"/></UniformGrid><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Style="{StaticResource Action}" Content="TAKE TICKER" Click="TakeTicker_Click"/><Button Style="{StaticResource Action}" Content="TAKE ROLL" Click="TakeRoll_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="ClockCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CLOCK / TIMER / STOPWATCH" FontWeight="Bold"/><UniformGrid Columns="3" Margin="0,6"><TextBox x:Name="ClockX" Text="0.82"/><TextBox x:Name="ClockY" Text="0.04"/><TextBox x:Name="ClockSize" Text="30"/></UniformGrid><WrapPanel><Button Style="{StaticResource Action}" Content="CLOCK" Click="TakeClock_Click"/><Button Style="{StaticResource Action}" Content="TIMER" Click="TakeTimer_Click"/><Button Style="{StaticResource Action}" Content="STOPWATCH" Click="TakeStopwatch_Click"/></WrapPanel></StackPanel></Border>
    <Border x:Name="NowCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="NOW / NEXT" FontWeight="Bold"/><TextBox x:Name="NowText" Text="NOW PLAYING" Margin="0,6,0,3"/><TextBox x:Name="NextText" Text="NEXT PLAYING" Margin="0,0,0,6"/><Button Style="{StaticResource Action}" Content="TAKE NOW/NEXT" Click="TakeNowNext_Click"/></StackPanel></Border>
    <Border x:Name="ShapeCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SHAPE / L-SHAPE" FontWeight="Bold"/><UniformGrid Columns="5" Margin="0,6"><TextBox x:Name="ShapeX" Text="0.02"/><TextBox x:Name="ShapeY" Text="0.72"/><TextBox x:Name="ShapeW" Text="0.70"/><TextBox x:Name="ShapeH" Text="0.16"/><TextBox x:Name="ShapeHex" Text="#17364D"/></UniformGrid><WrapPanel><Button Style="{StaticResource Action}" Content="TAKE SHAPE" Click="TakeShape_Click"/><Button Style="{StaticResource Action}" Content="L-SHAPE ON" Click="LShapeOn_Click"/><Button Style="{StaticResource Action}" Content="L-SHAPE OFF" Click="LShapeOff_Click"/></WrapPanel></StackPanel></Border>
    <Border x:Name="FullCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="FULL SCREEN GRAPHIC" FontWeight="Bold"/><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="BROWSE" Click="BrowseFull_Click"/><TextBox x:Name="FullPath" IsReadOnly="True"/></DockPanel><TextBox x:Name="FullOpacity" Text="1"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Style="{StaticResource Action}" Content="TAKE FULL" Click="TakeFull_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearFull_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="PipCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MOVING VIDEO PIP" FontWeight="Bold"/><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="BROWSE" Click="BrowsePip_Click"/><TextBox x:Name="PipPath" IsReadOnly="True"/></DockPanel><UniformGrid Columns="5"><TextBox x:Name="PipX" Text="0.70"/><TextBox x:Name="PipY" Text="0.08"/><TextBox x:Name="PipW" Text="0.26"/><TextBox x:Name="PipH" Text="0.26"/><TextBox x:Name="PipOpacity" Text="1"/></UniformGrid><CheckBox x:Name="PipLoop" Content="LOOP" IsChecked="True" Foreground="White"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="TAKE PIP" Click="TakePip_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearPip_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="SequenceCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="IMAGE SEQUENCE" FontWeight="Bold"/><Button Style="{StaticResource Action}" Content="SELECT FRAMES" Click="BrowseSequence_Click"/><TextBlock x:Name="SequenceInfo" Text="0 frames" Foreground="#9FB0C0"/><UniformGrid Columns="6"><TextBox x:Name="SeqX" Text="0.05"/><TextBox x:Name="SeqY" Text="0.05"/><TextBox x:Name="SeqW" Text="0.30"/><TextBox x:Name="SeqH" Text="0.30"/><TextBox x:Name="SeqOpacity" Text="1"/><TextBox x:Name="SeqFps" Text="12"/></UniformGrid><CheckBox x:Name="SeqLoop" Content="LOOP" IsChecked="True" Foreground="White"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="TAKE SEQUENCE" Click="TakeSequence_Click"/><Button Style="{StaticResource Action}" Content="CLEAR" Click="ClearSequence_Click"/></StackPanel></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="＋ NEW TEMPLATE" Click="NewTemplate_Click"/><Button Style="{StaticResource Action}" Content="📂 OPEN" Click="OpenTemplate_Click"/><Button Style="{StaticResource Action}" Content="💾 SAVE" Click="SaveProfile_Click"/><Button Style="{StaticResource Action}" Content="SAVE AS" Click="SaveAsTemplate_Click"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource Action}" Background="#168B3D" Content="▶ PREVIEW" Click="PreviewAll_Click"/><Button Style="{StaticResource Action}" Content="■ STOP PREVIEW" Click="StopPreview_Click"/><Button Style="{StaticResource Action}" Content="CLEAR SELECTED" Click="ClearSelected_Click"/><Button Style="{StaticResource Action}" Background="#E52E2E" BorderBrush="#FF6B6B" Content="TAKE TO AIR" Click="TakeSelectedToAir_Click"/><Button Style="{StaticResource Action}" Content="REMOVE FROM AIR" Click="RemoveSelectedFromAir_Click"/><Button Style="{StaticResource Action}" Content="CLOSE" Click="Close_Click"/></StackPanel></DockPanel>
 </Grid>
</Window>
