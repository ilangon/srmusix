<Window x:Class="SRMusix.Playout.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="SR MUSIX HD — Broadcast Playout" Width="1440" Height="900"
 MinWidth="1100" MinHeight="700" Background="#0A0D14" Foreground="White"
 AllowDrop="True" Drop="Window_Drop">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="185"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#151A26" CornerRadius="8" Padding="16,8">
   <DockPanel><TextBlock Text="SR MUSIX HD" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="OUTPUT" VerticalAlignment="Center" Margin="10"/><Ellipse x:Name="OutputLamp" Width="14" Height="14" Fill="#D23B3B" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,10,0">
    <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PLAYLIST" FontWeight="Bold" FontSize="16"/><StackPanel Orientation="Horizontal"><Button Content="＋ Add" Click="Add_Click"/><Button Content="Remove" Click="Remove_Click"/><Button Content="Clear" Click="Clear_Click"/></StackPanel></StackPanel>
     <ListBox x:Name="PlaylistBox" ItemsSource="{Binding PlaylistItems}" Background="#0E121B" Foreground="White" BorderThickness="0" Margin="0,8,0,0" MouseDoubleClick="Playlist_DoubleClick">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScheduledAt, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#8FA0BF"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox></DockPanel>
   </Border>
   <Border Grid.Column="1" Background="Black" CornerRadius="8" ClipToBounds="True">
    <Grid><vlc:VideoView x:Name="VideoView"/><Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"><TextBlock x:Name="LogoOverlay" Text="SR MUSIX HD" Foreground="#FFFFC845" FontWeight="Black" FontSize="30" Canvas.Left="24" Canvas.Top="20"/><Border x:Name="NowNextOverlay" Background="#C9000000" Padding="15,8" Canvas.Left="24" Canvas.Top="500"><TextBlock x:Name="NowNextText" Text="NOW: Standby&#x0a;NEXT: —" FontSize="18"/></Border><Border x:Name="TickerOverlay" Background="#DD9D1717" Height="42" Canvas.Left="0" Canvas.Top="600"><TextBlock x:Name="TickerText" Text="SR MUSIX HD • Feel the Music • Live the Vibe" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="15,0"/></Border></Canvas></Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="10,0,0,0">
    <StackPanel><TextBlock Text="OUTPUT &amp; CG" FontSize="16" FontWeight="Bold"/><TextBlock Text="Destination" Margin="0,12,0,3"/><TextBox x:Name="Destination" Text="rtmp://localhost/live/srmusix" Padding="6"/><TextBlock Text="Video codec" Margin="0,10,0,3"/><ComboBox x:Name="Codec" SelectedIndex="0"><ComboBoxItem Content="H.264"/><ComboBoxItem Content="H.265"/></ComboBox><TextBlock Text="Bitrate (kbps)" Margin="0,10,0,3"/><TextBox x:Name="Bitrate" Text="8000" Padding="6"/><Button Content="START OUTPUT" Background="#A97708" Click="StartOutput_Click"/><Button Content="STOP OUTPUT" Click="StopOutput_Click"/><Separator Margin="0,10"/><CheckBox x:Name="ShowLogo" Content="Logo / watermark" IsChecked="True" Click="OverlayToggle_Click"/><CheckBox x:Name="ShowNowNext" Content="Now / Next" IsChecked="True" Click="OverlayToggle_Click"/><CheckBox x:Name="ShowTicker" Content="Ticker" IsChecked="True" Click="OverlayToggle_Click"/><TextBlock Text="Ticker text" Margin="0,8,0,3"/><TextBox x:Name="TickerInput" Text="SR MUSIX HD • Feel the Music • Live the Vibe" TextChanged="TickerInput_TextChanged" TextWrapping="Wrap"/><TextBlock Text="Hardware preset" Margin="0,10,0,3"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="Desktop Preview"/><ComboBoxItem Content="Blackmagic Intensity Pro 4K — 1080p50"/><ComboBoxItem Content="Blackmagic Intensity Pro 4K — 2160p30"/></ComboBox></StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TRANSPORT" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><Button Content="▶ PLAY" Background="#147A46" Click="Play_Click"/><Button Content="Ⅱ PAUSE" Click="Pause_Click"/><Button Content="■ STOP" Background="#8A2525" Click="Stop_Click"/><Button Content="▶| NEXT" Click="Next_Click"/></StackPanel><Slider x:Name="Position" Minimum="0" Maximum="1000" ValueChanged="Position_ValueChanged"/><TextBlock x:Name="TimeDisplay" Text="00:00:00 / 00:00:00" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="SCHEDULE" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ScheduleDate" SelectedDate="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/><TextBox x:Name="ScheduleTime" Text="20:00:00" Width="100" Margin="8,0"/><Button Content="Set selected" Click="SetSchedule_Click"/></StackPanel><TextBlock Text="Drop MPEG-1/2, VOB, DAT, MP4, MOV, MKV, TS files anywhere in this window." Foreground="#8FA0BF" Margin="4,15" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Column="2" x:Name="Log" Background="#0E121B" Foreground="#9BB0D1" BorderThickness="0"/></Grid></Border>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="READY — Add media to begin" VerticalAlignment="Center" Foreground="#8FA0BF"/>
 </Grid>
</Window>
