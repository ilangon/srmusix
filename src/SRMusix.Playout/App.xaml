<Application x:Class="SRMusix.Playout.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#151A26"/>
    <SolidColorBrush x:Key="Gold" Color="#FFC845"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Background" Value="#293249"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Resources>
</Application>

